{
    "schedule": "@daily",
    "default_args": {
        "owner": "douglas-oliveira",
        "sqls_path": "dags/src/scripts/common",
        "bronze_path": "dags/data/bronze",
        "file_format": "csv"
    },
    "tags": [
        "postgres",
        "mysql",
        "database"
    ],
    "tasks": [
        {
            "name": "pgdb-extraction-chassis-car",
            "script": "src.models.database.handler",
            "params": {
                "dbcreds": "database-postgres",
                "sql": "SELECT * FROM Chassis.Car",
                "output": "dags/data/bronze/chassis_car",
                "file_format": "csv"
            }
        },
        {
            "name": "sf-stage-chassis-car",
            "script": "src.models.snowflake.handler",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "{{sqls_path}}/sf_stage_table_delta_load.sql",
                "sql_params": {
                    "database": "sandbox",
                    "schema": "oliveirad",
                    "table": "chassis_car",
                    "file_format": "{{file_format}}",
                    "extraction_files_path": "{{bronze_path}}/chassis_car"
                }
            },
            "depends_on": [
                "pgdb-extraction-chassis-car"
            ]
        },
        {
            "name": "sf-bronze-chassis-car",
            "script": "src.models.snowflake.handler",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "{{sqls_path}}/sf_merge_delta_load.sql",
                "sql_params": {
                    "bronze_db": "RAW",
                    "silver_db": "DWH",
                    "schema": "oliveirad",
                    "table": "chassis_car",
                    "file_format": "{{file_format}}",
                    "merge_on": "tgt.k = upd.k"
                }
            },
            "depends_on": [
                "sf-stage-chassis-car"
            ]
        },
        {
            "name": "mysqldb-extraction-crm-clients",
            "script": "src.models.database.handler",
            "params": {
                "dbcreds": "database-mysql",
                "sql": "SELECT * FROM dellocred_crm.clients",
                "output": "{{bronze_path}}/crm_clients"
            }
        },
        {
            "name": "sf-stage-crm-clients",
            "script": "src.models.snowflake.handler",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "{{sqls_path}}/sf_stage_table_delta_load.sql",
                "sql_params": {
                    "database": "sandbox",
                    "schema": "oliveirad",
                    "table": "crm_clients",
                    "file_format": "{{file_format}}",
                    "extraction_files_path": "{{bronze_path}}/crm_clients"
                }
            },
            "depends_on": [
                "mysqldb-extraction-crm-clients"
            ]
        },
        {
            "name": "sf-bronze-crm-clients",
            "script": "src.models.snowflake.handler",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "{{sqls_path}}/sf_merge_delta_load.sql",
                "sql_params": {
                    "bronze_db": "RAW",
                    "silver_db": "DWH",
                    "schema": "oliveirad",
                    "table": "crm_clients",
                    "file_format": "{{file_format}}",
                    "merge_on": "tgt.k = upd.k"
                }
            },
            "depends_on": [
                "sf-stage-crm-clients"
            ]
        }
    ]
}