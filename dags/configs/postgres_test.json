{
    "schedule": "@daily",
    "default_args": {
        "owner": "douglas-oliveira",
        "start_date": "2024-01-01"
    },
    "tags": [
        "postgres",
        "mysql",
        "database"
    ],
    "tasks": [
        {
            "name": "database-extraction-postgres",
            "script": "dags/src/models/database.py",
            "params": {
                "dbcreds": "database-postgres",
                "sql": "SELECT * FROM Chassis.Car",
                "output": "dags/data/bronze/chassis_car",
                "file_format": "csv"
            }
        },
        {
            "name": "postgres-snowflake",
            "script": "dags/src/models/snowflake.py",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "SELECT 1"
            },
            "depends_on": [
                "database-extraction-postgres"
            ]
        },
        {
            "name": "database-extraction-mysql",
            "script": "dags/src/models/database.py",
            "params": {
                "dbcreds": "database-mysql",
                "sql": "SELECT * FROM dellocred_crm.clients",
                "output": "dags/data/bronze/crm_clients",
                "file_format": "csv"
            }
        },
        {
            "name": "mysql-snowflake",
            "script": "dags/src/models/snowflake.py",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "dags/src/scripts/common/test.sql",
                "sql_params": {
                    "database": "sandbox",
                    "schema": "oliveirad",
                    "table": "test"
                }
            },
            "depends_on": [
                "database-extraction-mysql"
            ]
        }
    ]
}