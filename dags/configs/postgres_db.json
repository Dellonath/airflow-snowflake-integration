{
    "schedule": "@daily",
    "default_args": {
        "owner": "douglas-oliveira",
        "file_format": "parquet",
        "database": "Chassis",
        "dbcreds": "database-postgres",
        "sqls_path": "dags/src/scripts/common",
        "bronze_path": "dags/data/bronze"
    },
    "tags": [
        "postgres",
        "mysql",
        "database"
    ],
    "tasks": [
        {
            "name": "database-extraction-postgres",
            "script": "src.models.database.handler",
            "params": {
                "sql": "SELECT * FROM {{database}}.Car",
                "output": "{{bronze_path}}/chassis_car"
            }
        },
        {
            "name": "postgres-snowflake",
            "script": "src.models.snowflake.handler",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "SELECT 1"
            },
            "depends_on": [
                "database-extraction-postgres"
            ]
        },
        {
            "name": "database-extraction-mysql",
            "script": "src.models.database.handler",
            "params": {
                "dbcreds": "database-mysql",
                "sql": "SELECT * FROM dellocred_crm.clients",
                "output": "{{bronze_path}}/crm_clients"
            }
        },
        {
            "name": "mysql-snowflake",
            "script": "src.models.snowflake.handler",
            "params": {
                "dbcreds": "snowflake-connection",
                "sql": "{{sqls_path}}/setup_snowflake.sql",
                "sql_params": {
                    "database": "sandbox",
                    "schema": "oliveirad",
                    "table": "test",
                    "path": "{{bronze_path}}/crm_clients"
                }
            },
            "depends_on": [
                "database-extraction-mysql"
            ]
        }
    ]
}